# Origin that serves the trusted site (local dev)
NEXT_PUBLIC_MAIN_ORIGIN=http://localhost:3000
# Origin that serves user profile documents; must be a different host from main so cookies are not shared
NEXT_PUBLIC_USERCONTENT_ORIGIN=http://127.0.0.1:3000
# Convex deployment URL (written to .env.local by `npx convex dev`)
NEXT_PUBLIC_CONVEX_URL=
# Comma-separated emails that get admin rights
ADMIN_EMAILS=
# Username of the house account every new member befriends
HOUSE_USERNAME=
# Display name of the house account
HOUSE_DISPLAY_NAME=
# Resend API key for password reset email
AUTH_RESEND_KEY=
# From address for outgoing email, e.g. OpenSpace <noreply@example.com>
AUTH_EMAIL_FROM=
# Cloudflare R2 API token
R2_TOKEN=
# R2 S3 access key id
R2_ACCESS_KEY_ID=
# R2 S3 secret access key
R2_SECRET_ACCESS_KEY=
# R2 S3 endpoint, e.g. https://<account-id>.r2.cloudflarestorage.com
R2_ENDPOINT=
# R2 bucket name for uploads
R2_BUCKET=
# Public base URL that serves the R2 bucket
NEXT_PUBLIC_R2_PUBLIC_URL=
